<Project>
  <!-- Toolbelt.Blazor.WebAssembly.ExtensibleGateway -->
  <PropertyGroup>
    <BzExGatewayHostDll>$(MSBuildThisFileDirectory)../tools/net11.0/blazor-extensible-gateway.dll</BzExGatewayHostDll>
    <BzExGatewayResponseFilePath>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)blazor-extensible-gateway.ini</BzExGatewayResponseFilePath>
  </PropertyGroup>

  <PropertyGroup>
    <_BlazorGatewayDll>$(BzExGatewayHostDll)</_BlazorGatewayDll>
    <!-- Prevents the runtime SDK (Microsoft.NET.Sdk.WebAssembly.Browser.targets) from overriding
         RunCommand/RunArguments with WasmAppHost when _UseBlazorDevServer is false. -->
    <_WebAssemblyUserRunParameters>true</_WebAssemblyUserRunParameters>
    <!-- Set RunCommand/RunArguments as static properties so they are visible to VS (F5/Ctrl+F5)
         which reads properties directly without running the ComputeRunArguments target. -->
    <_GatewayStaticWebAssetsManifest>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'staticwebassets.development.json'))</_GatewayStaticWebAssetsManifest>
    <_GatewayEndpointsManifest>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'staticwebassets.build.endpoints.json'))</_GatewayEndpointsManifest>
    <!-- Logging filters that suppress noisy framework and OTLP categories during local development.
         Set GatewayDisableDefaultLoggingFilters=true to get full default logging levels instead. -->
    <_GatewayDefaultLoggingFiltersArgs Condition="'$(GatewayDisableDefaultLoggingFilters)' != 'true'"> --Logging:LogLevel:Microsoft=Warning --Logging:LogLevel:Microsoft.Hosting.Lifetime=Information --Logging:LogLevel:System.Net.Http.HttpClient.OtlpExporter=Warning</_GatewayDefaultLoggingFiltersArgs>
    <!-- Everything after the bare double dash separator is forwarded to the stock gateway verbatim. -->
    <_BzExGatewayCoreArgs>--environment Development --staticWebAssets &quot;$(_GatewayStaticWebAssetsManifest)&quot; --ClientApps:app:EndpointsManifest &quot;$(_GatewayEndpointsManifest)&quot; --ClientApps:app:PathPrefix &quot;&quot;$(_GatewayDefaultLoggingFiltersArgs)</_BzExGatewayCoreArgs>
    <RunCommand>dotnet</RunCommand>
    <RunArguments>&quot;$(BzExGatewayHostDll)&quot; --responsefilepath &quot;$(BzExGatewayResponseFilePath)&quot; -- $(_BzExGatewayCoreArgs)</RunArguments>
  </PropertyGroup>

  <Target Name="BzExGateway_GenerateResponseFile" BeforeTargets="Build">
    <ItemGroup>
      <BzExGatewayResponseFileLine Include="[ExtensionAssemblies]" />
      <BzExGatewayResponseFileLine Include="@(BzExGatewayAssemblyPath)" />
      <BzExGatewayResponseFileLine Include="[EnvironmentVariables]" />
      <BzExGatewayResponseFileLine Include="@(BzExGatewayEnvValue)" />
    </ItemGroup>

    <WriteLinesToFile File="$(BzExGatewayResponseFilePath)" Lines="@(BzExGatewayResponseFileLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
